{
  "name": "brimmar/phpstan-rustlike-option-extension",
  "description": "A PHPStan extension to help with the Option Type implementation for PHP",
  "type": "phpstan-extension",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Brimmar\\PHPStan\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Brimmar\\PHPStan\\Tests\\": "tests/",
      "Brimmar\\PhpOption\\": "tests/Fixture/Option/",
      "Brimmar\\PhpResult\\Interfaces\\": "tests/Fixture/"
    }
  },
  "authors": [
    {
      "name": "Bryan",
      "email": "bryan.sergio@brimmar.dev"
    }
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "extra": {
    "phpstan": {
      "includes": [
        "extension.neon"
      ]
    }
  },
  "require": {
    "php": ">=8.5",
    "phpstan/phpstan": "^2.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5.66"
  }
}
